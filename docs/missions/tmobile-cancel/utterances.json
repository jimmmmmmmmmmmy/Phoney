{
  "mission_id": "tmobile-cancel",
  "brevity": "strict",
  "lines": [
    {"id": "open-cancel", "when": "person-opens", "kind": "default", "text": "I'd like to cancel the line ending in {line_last4}."},
    {"id": "open-watch", "when": "watch-line", "kind": "default", "text": "Cancel the Apple Watch cellular line."},
    {"id": "next-line", "when": "second-line", "kind": "default", "text": "Next, cancel the line ending in {line_last4}."},
    {"id": "which-line", "when": "which-line", "kind": "default", "text": "The {line_label} line is {line_display}."},
    {"id": "only-named", "when": "whole-account", "kind": "default", "text": "Cancel only the two named lines, not a port or a suspend."},
    {"id": "leave-others", "when": "whole-account", "kind": "default", "text": "Leave every other line, including Beata's, active."},
    {"id": "decline-offer", "when": "retention-below-policy", "kind": "default", "text": "I'm not interested in offers."},
    {"id": "cancel-line", "when": "retention-below-policy", "kind": "default", "text": "Please cancel line {line_display}."},
    {"id": "decline-plan", "when": "cheaper-plan", "kind": "default", "text": "No plan change, please cancel line {line_display}."},
    {"id": "promo-still-cancel", "when": "promo-scare", "kind": "default", "text": "Please still cancel line {line_display}."},
    {"id": "eip-ok", "when": "device-payments", "kind": "default", "text": "That is fine, please cancel line {line_display}."},
    {"id": "ask-confirm", "when": "after-cancel", "kind": "default", "text": "What is the confirmation number and effective date?"},
    {"id": "readback", "when": "confirmation", "kind": "confirmation", "text": "Confirmed. Line {line_display}, confirmation {code}, effective {date}."},
    {"id": "accept-retention", "when": "retention-meets-policy", "kind": "default", "text": "I'll accept the monthly credit instead of canceling."},
    {"id": "need-holder", "when": "missing-secret", "kind": "default", "text": "I need the account holder on the line."},
    {"id": "say-account", "when": "account-number", "kind": "default", "text": "The account number is {account_number}."},
    {"id": "say-name", "when": "account-name", "kind": "default", "text": "The account name is {account_name}."},
    {"id": "say-pin", "when": "pin", "kind": "default", "text": "The PIN is {pin}."},
    {"id": "say-ssn", "when": "ssn", "kind": "default", "text": "The last four are {ssn_last4}."},
    {"id": "say-zip", "when": "zip", "kind": "default", "text": "The billing ZIP is {billing_zip}."},
    {"id": "goodbye", "when": "done", "kind": "default", "text": "Thank you, goodbye."},
    {"id": "partial-close", "when": "line-blocked", "kind": "default", "text": "That line could not be canceled."},
    {"id": "ivr-english", "when": "language", "kind": "default", "text": "English."},
    {"id": "ivr-no-number", "when": "ivr-number-prompt", "kind": "default", "text": "I don't have one."},
    {"id": "ivr-something-else", "when": "ivr-menu", "kind": "default", "text": "Something else."},
    {"id": "ivr-cancel", "when": "ivr-intent", "kind": "default", "text": "Cancel a line."},
    {"id": "ivr-representative", "when": "ivr-wipe", "kind": "default", "text": "Representative."},
    {"id": "wrong-department", "when": "wrong-department", "kind": "default", "text": "I need to cancel a line."},
    {"id": "supervisor", "when": "cancel-refused", "kind": "default", "text": "Please transfer me to a supervisor."},
    {"id": "unpair-watch", "when": "watch-pairing", "kind": "default", "text": "Unpair that watch line before canceling it."},
    {"id": "watch-separate", "when": "port-claim", "kind": "default", "text": "Please cancel the watch line too."}
  ]
}
