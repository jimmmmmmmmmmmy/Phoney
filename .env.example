# Copy to .env and fill locally. Never commit credentials.
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
# Optional REST API credentials; webhook validation still needs AUTH_TOKEN.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_NUMBER=+17864225408
# ngrok (default) or cloudflare (Quick Tunnel, or named tunnel with both settings below).
TUNNEL_PROVIDER=ngrok
# Cloudflare: auto enables fallback; use http2 on networks blocking UDP/QUIC.
TUNNEL_TRANSPORT_PROTOCOL=auto
# Named Cloudflare Tunnel: set both; leave both empty for an accountless Quick Tunnel.
# Absolute path to a private YAML file with tunnel, credentials-file, and ingress.
CLOUDFLARE_TUNNEL_CONFIG=
# HTTPS hostname origin only, e.g. https://phoney.dev (no trailing slash).
CLOUDFLARE_PUBLIC_URL=
# scripts/dev.py start fills this from the selected running tunnel.
PUBLIC_BASE_URL=
# Build 1: a fixed teammate's phone in E.164 format. Empty keeps the greeting.
CALLEE_NUMBER=
# Optional automatic deployment from this repository's main branch.
GITHUB_WEBHOOK_SECRET=
DEPLOY_REPOSITORY=jimmmmmmmmmmmy/fictional-rotary-phone
# Absolute path on the server, e.g. /path/to/repo/.runtime/deploy.trigger
DEPLOY_TRIGGER_PATH=
# Private bearer token for call-aware deployment; use at least 32 random characters.
DEPLOY_CONTROL_TOKEN=
# Build 2: passive recording to private local WAV files; no AI providers.
MEDIA_CAPTURE_ENABLED=false
# Required absolute path when enabled; keep outside per-release directories.
MEDIA_STORAGE_DIR=
# Stop capture after this duration; the human call continues.
MEDIA_MAX_SECONDS=1800
# Build 3: optional live transcription; the phone conference remains independent.
TRANSCRIPTION_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
TRANSCRIPT_STORAGE_DIR=
# Optional durable caller numbers, call durations, and saved transcript summaries.
# Use an absolute private path outside per-release directories.
CALL_DETAILS_STORAGE_DIR=
# Shared contacts and agent drafts, using an absolute private directory outside releases.
# Empty disables workspace writes; there is no browser-only save fallback.
WORKSPACE_STORAGE_DIR=
# Automatic summaries after the call and transcript finish; leave the key empty to disable.
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-3.8-flash
# Optional Modulate analysis of new calls' inbound audio; never backfills recordings.
# Requires MEDIA_CAPTURE_ENABLED. Results change a live call only when the
# separate AUTOMATIC_TAKEOVER_ENABLED flag below is enabled.
MODULATE_DETECTION_ENABLED=false
# Opt in to processing finalized caller WAVs, including existing recordings.
# Reuses successful analysis and only submits missing coverage; private serial jobs.
MODULATE_BACKFILL_ENABLED=false
MODULATE_API_KEY=
DETECTION_STORAGE_DIR=
# Maximum audio per provider session; live sessions rotate throughout the call.
MODULATE_DETECTION_MAX_AUDIO_SECONDS=120
# Provider send/finalization deadline, separate from the live audio collection time.
MODULATE_DETECTION_DEADLINE_SECONDS=45
MODULATE_DETECTION_MIN_CONFIDENCE=0.80
MODULATE_DETECTION_QUEUE_FRAMES=250
# Dashboard, caller numbers, summaries, audio, and transcripts are public to anyone with the server URL.
# Optional voicemail when the teammate cannot answer; Twilio Say/Record, no AI agent.
VOICEMAIL_ENABLED=false
VOICEMAIL_MAX_SECONDS=120
VOICEMAIL_STORAGE_DIR=
# Build 4: the two-leg operator bridge. Every value is optional; while they are
# empty the conference path above keeps working exactly as before.
# The owner's own phone: called first, and never a permitted destination.
OWNER_NUMBER=
# Comma-separated E.164 numbers this bridge may dial. Never the owner number or
# TWILIO_NUMBER.
ALLOWED_DESTINATIONS=
# Private bearer token for /api/calls/* and /api/sessions/*; at least 32 random characters.
OPERATOR_ADMIN_TOKEN=
# Application deadline for one bridged call, in seconds. Twilio's per-call
# time_limit uses the same value.
MAX_CALL_SECONDS=1800
# Build 4: owner voice replies. Every value below is optional until you enable it.
VOICE_AGENT_ENABLED=false
# Persistent, owner-authenticated agent/voice configuration in the Agents tab.
# Generate a one-time owner sign-in code with scripts/operator_access.py.
AGENT_MANAGEMENT_ENABLED=false
# Demo: allow same-origin agent editing without an owner login. Keypad takeover
# still requires the owner phone; paid voice enrollment and outbound APIs stay protected.
AGENT_DEMO_MODE=false
# Opt-in transport for NEW incoming calls. Calls start by ringing the owner;
# #1-#9 manually select a published agent and #0 returns to the human.
OPERATOR_INBOUND_ENABLED=false
# Opt in to one automatic handoff when live caller audio shows AI Detected.
# Requires the inbound bridge and live Modulate detection. Uses a private
# three-reply personality and ready owner voice, independent of public agents.
# A manual selection or #0 suppresses further automatic handoffs for that call.
AUTOMATIC_TAKEOVER_ENABLED=false
# Unanswered inbound bridge calls use a conversational voicemail assistant.
# Requires the inbound bridge, providers, transcription, and ready owner voice.
# Independent of VOICEMAIL_ENABLED (the legacy conference Say/Record flow).
VOICEMAIL_AGENT_ENABLED=false
# Application wait for owner answer, 5-60 seconds; ring cadence varies by carrier.
VOICEMAIL_AGENT_RING_SECONDS=10
GEMINI_MODEL=gemini-3.5-flash-lite
# The key above is shared with summaries. This one needs the text_to_speech,
# voices_write and text_to_voice permissions; without voices_write,
# voice_check.py --list-voices still passes but no voice can be added.
# Default (premade) voices expire on 2026-12-31. A cloned or designed voice does not.
ELEVENLABS_API_KEY=
# Voice identifier from your account. Not a secret, but keep it out of code.
ELEVENLABS_VOICE_ID=
# Flash keeps phone latency low; ulaw_8000 matches Twilio exactly, with no resampling.
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
# Required absolute path when enabled. Local WAVs are for listening only; the
# designed-voice previews from scripts/design_voice.py are stored here too.
VOICE_OUTPUT_DIR=
VOICE_MAX_REPLY_TOKENS=2048
VOICE_REQUEST_TIMEOUT=20
